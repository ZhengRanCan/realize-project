  "topics": [
    {
      "id": "T-Purpose",
      "title": "Purpose and F40/F41 scope",
      "proposition": "本文档定位为 F40 规划领域目标数据模型契约，并明确 F40/F41 的非目标与后续边界。",
      "sectionRefs": [
        "§Purpose"
      ]
    },
    {
      "id": "T-F40",
      "title": "F40 conclusion and core chains",
      "proposition": "目标核心链路是 Goal+UserProfile→InitialPlanContext→PlanBundle，重规划链路是上下文→ReplanContext→新 PlanBundle/PlanChangeSet；DailyPlan[] 仅 legacy。",
      "sectionRefs": [
        "§F40 conclusion"
      ]
    },
    {
      "id": "T-ModelLayers",
      "title": "Model layers",
      "proposition": "模型分为持久化真值、瞬态 planner 输入、计算视图、legacy 兼容四层。",
      "sectionRefs": [
        "§Model layers"
      ]
    },
    {
      "id": "T-Initial",
      "title": "Initial planning flow",
      "proposition": "初始规划从 Goal+UserProfile 组装 InitialPlanContext 生成 PlanBundle，不依赖 DailyReview，AI 输出必须校验。",
      "sectionRefs": [
        "§Initial planning flow"
      ]
    },
    {
      "id": "T-Replan",
      "title": "Replanning flow",
      "proposition": "重规划由多种 Trigger 驱动，装配 ReplanContext 后产出新 PlanBundle/PlanChangeSet，并保留历史事实。",
      "sectionRefs": [
        "§Replanning flow"
      ]
    },
    {
      "id": "T-Goal",
      "title": "Goal",
      "proposition": "Goal 是目标意图与目标级硬约束，含 F40/F65 字段、每日预算、完成/取消与偏好边界。",
      "sectionRefs": [
        "§Goal"
      ]
    },
    {
      "id": "T-UserProfile",
      "title": "UserProfile",
      "proposition": "UserProfile 是跨目标可复用上下文，区分排期偏好与表达偏好，并限制 energy/MBTI/仪式用途。",
      "sectionRefs": [
        "§UserProfile"
      ]
    },
    {
      "id": "T-PlanBundle",
      "title": "PlanBundle",
      "proposition": "PlanBundle 是核心持久化规划聚合，含 Plan/Stage/Task，可序列化且页面只消费派生视图。",
      "sectionRefs": [
        "§PlanBundle"
      ]
    },
    {
      "id": "T-Plan",
      "title": "Plan",
      "proposition": "Plan 是计划元数据与策略记录，含生成来源、可行性、结构类型、调整风险与重规划保留规则。",
      "sectionRefs": [
        "§Plan"
      ]
    },
    {
      "id": "T-Stage",
      "title": "Stage",
      "proposition": "Stage 是长程阶段，含 purpose/outcome/scopeNotes/estimatedMinutes，不替代 Task 且不自动完成 Goal。",
      "sectionRefs": [
        "§Stage"
      ]
    },
    {
      "id": "T-Task",
      "title": "Task",
      "proposition": "Task 是最小可执行规划单元，含目标形态字段、依赖、排期、minimumLine 与完成/跳过语义。",
      "sectionRefs": [
        "§Task"
      ]
    },
    {
      "id": "T-TaskCard",
      "title": "Task Card computed contract",
      "proposition": "Task Card 计算契约由纯 selector 派生 availability、锁定依赖与确定性推荐。",
      "sectionRefs": [
        "§Task Card computed contract"
      ]
    },
    {
      "id": "T-FocusSession",
      "title": "FocusSession, TaskResult and DailyReview",
      "proposition": "FocusSession、TaskResult、DailyReview 是独立执行概念，分别承载计时、任务结果与日回顾。",
      "sectionRefs": [
        "§FocusSession, TaskResult and DailyReview"
      ]
    },
    {
      "id": "T-TodayTaskSelection",
      "title": "TodayTaskSelection",
      "proposition": "TodayTaskSelection 记录某日决定执行哪个既有 Task，并受活动 PlanBundle、依赖与日期授权约束。",
      "sectionRefs": [
        "§TodayTaskSelection"
      ]
    },
    {
      "id": "T-DailyReview",
      "title": "DailyReview",
      "proposition": "DailyReview 是日级执行历史，含兼容字段、隐私边界与不得被重规划改写的不变量。",
      "sectionRefs": [
        "§DailyReview"
      ]
    },
    {
      "id": "T-Dismissal",
      "title": "DailyReviewPromptDismissal",
      "proposition": "DailyReviewPromptDismissal 是 UI 提示历史，不是执行或回顾真值，且有资格与级联规则。",
      "sectionRefs": [
        "§DailyReviewPromptDismissal"
      ]
    },
    {
      "id": "T-PlanChangeSummary",
      "title": "PlanChangeSummary",
      "proposition": "PlanChangeSummary 是确定性调整的持久化回执，幂等、原子、保护隐私且不复制真值。",
      "sectionRefs": [
        "§PlanChangeSummary"
      ]
    },
    {
      "id": "T-Legacy",
      "title": "DailyPlan legacy boundary",
      "proposition": "DailyPlan[] 不属于未来核心领域模型，仅保留 legacy storage/adapter 兼容，并有删除方向与迁移风险。",
      "sectionRefs": [
        "§DailyPlan legacy boundary"
      ]
    },
    {
      "id": "T-ComputedViews",
      "title": "Computed views",
      "proposition": "计算视图不是持久化真值，页面数据由 service/selector 从核心模型生成。",
      "sectionRefs": [
        "§Computed views"
      ]
    },
    {
      "id": "T-Migration",
      "title": "Migration direction",
      "proposition": "F40 之后的迁移被拆成后续特性步骤，不得视作 F40 的一部分。",
      "sectionRefs": [
        "§Migration direction"
      ]
    },
    {
      "id": "T-Historical",
      "title": "Historical notes",
      "proposition": "历史记录 F16/F39/F41/F56/F58 对模型字段、校验、类型与创建路径的增量。",
      "sectionRefs": [
        "§Historical notes",
        "§2026-05-26 F16",
        "§2026-06-26 F39",
        "§2026-06-27 F41",
        "§2026-07-03 F56",
        "§2026-07-09 F58"
      ]
    }
  ],
