  "topics": [
    {
      "id": "T-00",
      "title": "文档范围与权威",
      "proposition": "本文档是规划域 F40 的 target data model contract：只做模型与迁移方向评审，后续迁移以它为 source of truth。",
      "sectionRefs": [
        "§Purpose"
      ]
    },
    {
      "id": "T-01",
      "title": "核心规划链与持久真相",
      "proposition": "目标域核心链是 Goal + UserProfile → 临时 planner 输入 → PlanBundle；重规划产出新 PlanBundle/受控变更集或显式 infeasible，DailyReview 是执行事实，DailyPlan[] 不是未来核心模型。",
      "sectionRefs": [
        "§F40 conclusion"
      ]
    },
    {
      "id": "T-02",
      "title": "模型分层",
      "proposition": "模型分四层：持久真相、临时 planner 输入、计算视图、遗留兼容；四层可同时成立，是判读维度而非互斥状态。",
      "sectionRefs": [
        "§Model layers"
      ]
    },
    {
      "id": "T-03",
      "title": "初始规划流",
      "proposition": "初始规划在没有执行历史时从用户意图与可复用用户上下文组装临时上下文，AI 输出经校验后成为第一个 PlanBundle。",
      "sectionRefs": [
        "§Initial planning flow"
      ]
    },
    {
      "id": "T-04",
      "title": "重规划流",
      "proposition": "现实偏离计划（拒绝/反馈/阶段完成/复盘部分或跳过/容量或截止变化/不可行）时重规划更新或替换计划，并保留执行历史。",
      "sectionRefs": [
        "§Replanning flow"
      ]
    },
    {
      "id": "T-05",
      "title": "Goal 语义与边界",
      "proposition": "Goal 承载用户原始目标意图与目标范围硬约束，不承载表达风格、执行反馈、计划策略或展示文案。",
      "sectionRefs": [
        "§Goal"
      ]
    },
    {
      "id": "T-06",
      "title": "UserProfile 语义与边界",
      "proposition": "UserProfile 承载跨目标的排期偏好与表达偏好；MBTI/仪式偏好只影响表达与轻度排序，实际执行精力属 DailyReview。",
      "sectionRefs": [
        "§UserProfile"
      ]
    },
    {
      "id": "T-07",
      "title": "PlanBundle 聚合",
      "proposition": "PlanBundle 是初始规划与重规划的主要持久输出，页面只消费由它派生的 service/view-model 输出。",
      "sectionRefs": [
        "§PlanBundle"
      ]
    },
    {
      "id": "T-08",
      "title": "Plan 状态与 detailedThrough",
      "proposition": "Plan 用 structureType、detailedThrough、status 与 adjustmentRisk 表达计划窗口与可行性；infeasible 必须显式，未决风险不得被静默升降级。",
      "sectionRefs": [
        "§Plan"
      ]
    },
    {
      "id": "T-09",
      "title": "Stage 长程阶段",
      "proposition": "Stage 覆盖整个计划窗口、用于长程概览与细化，其日期必须落在父计划内，完成不自动完成 Goal。",
      "sectionRefs": [
        "§Stage"
      ]
    },
    {
      "id": "T-10",
      "title": "Task 与依赖",
      "proposition": "Task 是 detailedThrough 之前的具体执行单元，依赖用 dependsOnTaskIds 显式表达且必须同属一个 PlanBundle、无环。",
      "sectionRefs": [
        "§Task"
      ]
    },
    {
      "id": "T-11",
      "title": "Task Card 计算契约",
      "proposition": "卡片状态由计算得出（done→closed、存在未完成显式依赖→locked、其余→available），唯一推荐按 scheduledDate → priority → 稳定 id 确定性产生。",
      "sectionRefs": [
        "§Task Card computed contract"
      ]
    },
    {
      "id": "T-12",
      "title": "执行事实与日复盘",
      "proposition": "FocusSession、TaskResult 与 DailyReview 是三个独立领域概念：前者提供任务范围执行证据，后者是该 Goal/date 的日范围事实。",
      "sectionRefs": [
        "§FocusSession, TaskResult and DailyReview"
      ]
    },
    {
      "id": "T-13",
      "title": "今日任务选择",
      "proposition": "TodayTaskSelection 授权今日执行哪些 Task（每 Goal/Plan/date 一条、必须引用 active PlanBundle），它不是执行事实也不是排期变更。",
      "sectionRefs": [
        "§TodayTaskSelection"
      ]
    },
    {
      "id": "T-14",
      "title": "DailyReview 事实与隐私",
      "proposition": "DailyReview 是历史事实，重规划可读不可改写；备注是用户私密数据，默认不得日志或上传。",
      "sectionRefs": [
        "§DailyReview"
      ]
    },
    {
      "id": "T-15",
      "title": "复盘提示 dismissal",
      "proposition": "DailyReviewPromptDismissal 只是用户跳过复盘提示的 UI 历史，不构成执行或复盘真相，也不能授权其他日期或 Plan。",
      "sectionRefs": [
        "§DailyReviewPromptDismissal"
      ]
    },
    {
      "id": "T-16",
      "title": "PlanChangeSummary 收据",
      "proposition": "PlanChangeSummary 解释一次确定性调整的收据，引用稳定 Task id 与日期，不是第二个 Plan 真相源。",
      "sectionRefs": [
        "§PlanChangeSummary"
      ]
    },
    {
      "id": "T-17",
      "title": "DailyPlan[] legacy 边界",
      "proposition": "DailyPlan[] 只是迁移未完成期间的遗留存储与兼容读写面（含已知风险），不属于未来核心模型，删除留待独立特性。",
      "sectionRefs": [
        "§DailyPlan legacy boundary"
      ]
    },
    {
      "id": "T-18",
      "title": "计算视图",
      "proposition": "DailyTaskView / TodaySuggestionView / PlanBundleCalendarView 等计算视图由 services/selectors 从 PlanBundle、DailyReview、UserProfile 生成，不是持久真相。",
      "sectionRefs": [
        "§Computed views"
      ]
    },
    {
      "id": "T-19",
      "title": "迁移方向",
      "proposition": "F40 之后的迁移拆分为若干后续特性（扩字段、定义 AI/replanner schema、改造确定性 planner、替换消费面、破坏性删除 DailyPlan[] 与旧存储键），都不属于 F40。",
      "sectionRefs": [
        "§Migration direction"
      ]
    },
    {
      "id": "T-20",
      "title": "历史沿革",
      "proposition": "F16/F39/F41/F56/F58 记录了目标模型逐次成形的历史：校验、运行时输入类型、可选字段、创建屏与确认写入路径。",
      "sectionRefs": [
        "§Historical notes",
        "§2026-05-26 F16",
        "§2026-06-26 F39",
        "§2026-06-27 F41",
        "§2026-07-03 F56",
        "§2026-07-09 F58"
      ]
    }
  ],
