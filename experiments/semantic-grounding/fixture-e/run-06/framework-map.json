  "topics": [
    {
      "id": "T-01",
      "title": "F13–F16 售后链路与依赖顺序",
      "proposition": "F13→F14→F15→F16 按固定依赖顺序构成售后链路，替代 F12 并已全部 passing。",
      "sectionRefs": [
        "§1"
      ]
    },
    {
      "id": "T-02",
      "title": "本地前置：代码校验与构建",
      "proposition": "部署前必须对相关云函数做 node --check 并完成 h5 / mp-weixin 构建，且仓库不得纳入敏感文件。",
      "sectionRefs": [
        "§2"
      ]
    },
    {
      "id": "T-03",
      "title": "CloudBase 部署",
      "proposition": "云函数按 1–11 顺序部署，并配置定时触发器、HTTP 网关路由与沙箱环境变量。",
      "sectionRefs": [
        "§3"
      ]
    },
    {
      "id": "T-04",
      "title": "沙箱模式运行验证",
      "proposition": "用三个用例、mock 通知、查单 cron、失败重试与强制补偿在沙箱下验证整条售后链路。",
      "sectionRefs": [
        "§4"
      ]
    },
    {
      "id": "T-05",
      "title": "证据留存规范",
      "proposition": "每个 Feature passing 前必须留存指定截图 / 日志 / 审计证据。",
      "sectionRefs": [
        "§5"
      ]
    },
    {
      "id": "T-06",
      "title": "独立审查 Checklist",
      "proposition": "F13–F16（含 F12 重新验收）的验收项由独立 reviewer 逐条复核。",
      "sectionRefs": [
        "§6"
      ]
    },
    {
      "id": "T-07",
      "title": "沙箱 → 真实环境切换",
      "proposition": "沙箱 passing 后配置真实模式环境变量、移除 mock 入口并做小额真实退款回归。",
      "sectionRefs": [
        "§7"
      ]
    },
    {
      "id": "T-08",
      "title": "故障排查速查",
      "proposition": "给出常见症状到原因与处置的速查表。",
      "sectionRefs": [
        "§8"
      ]
    },
    {
      "id": "T-09",
      "title": "与 F01 支付域的边界",
      "proposition": "F16 退款域独立于支付域，仅通过缺省回退共享 WX_PAY_*，且不修改支付核心文件。",
      "sectionRefs": [
        "§9"
      ]
    },
    {
      "id": "T-10",
      "title": "未发货仅退款库存释放时机决策",
      "proposition": "在保守（REFUND_SUCCESS 释放）与激进（APPROVE 释放）两种实现间由 reviewer 决策，默认推荐保守。",
      "sectionRefs": [
        "§10"
      ]
    },
    {
      "id": "T-11",
      "title": "修订记录",
      "proposition": "记录文档版本修订（如 v0.3 新增 reviewer 入门指南）。",
      "sectionRefs": [
        "§11"
      ]
    }
  ],
