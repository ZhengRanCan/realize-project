  "defaultExpanded": false,
  "content": {
    "type": "checklist",
    "panels": [
      {
        "title": "不要求盲目服从",
        "variant": "info",
        "sourceUnitIds": [
          "SU-028",
          "SU-029"
        ],
        "items": [
          {
            "text": "某项 Recommended 被纳入设计考虑后最终没有采用，仍可能满足 Consumption。",
            "note": "",
            "variant": "ok",
            "sourceUnitIds": [
              "SU-028"
            ]
          },
          {
            "text": "在 Output Alignment 中记录为 Not adopted，但不能伪称为已经采用。",
            "note": "",
            "variant": "warn",
            "sourceUnitIds": [
              "SU-087"
            ]
          },
          {
            "text": "如果系统完全没有把某项 guidance 纳入生成设计考虑，问题可能反映 Consumption 不充分，而不应仅由 Output Alignment 的最终采用状态解释。",
            "note": "",
            "variant": "warn",
            "sourceUnitIds": [
              "SU-029"
            ]
          }
        ]
      },
      {
        "title": "不要求最终输出必须明显不同",
        "variant": "info",
        "sourceUnitIds": [
          "SU-030",
          "SU-031"
        ],
        "items": [
          {
            "text": "如果冻结上下文判断当前学习者和课程与通用设计一致，最终 outline 可能与默认 outline 相近。",
            "note": "",
            "variant": "ok",
            "sourceUnitIds": [
              "SU-030"
            ]
          },
          {
            "text": "若要求可见差异，系统会为了证明个性化而强行制造结构差异，反而可能破坏合理的课程设计。",
            "note": "",
            "variant": "bad",
            "sourceUnitIds": [
              "SU-031"
            ]
          }
        ]
      }
    ]
  }
}
