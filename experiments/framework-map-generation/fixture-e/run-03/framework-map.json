  "topics": [
    {
      "id": "t-chain-overview",
      "title": "链路总览与依赖",
      "proposition": "F13 → F14 → F15 → F16 构成售后链路，F12 已被这四个 Feature 替代且在 Round 19 完成 unblock 并切 passing。",
      "sectionRefs": [
        "§1"
      ]
    },
    {
      "id": "t-local-prereq",
      "title": "本地前置：代码与构建",
      "proposition": "部署前需本地通过 node --check、npm 构建，并确认 .gitignore 屏蔽 .env / *.pem / *.key 等敏感文件。",
      "sectionRefs": [
        "§2"
      ]
    },
    {
      "id": "t-cloudbase-deploy",
      "title": "CloudBase 部署",
      "proposition": "按顺序部署售后链路云函数，并配置定时触发器、/refundNotify HTTP 网关路由与沙箱模式环境变量。",
      "sectionRefs": [
        "§3"
      ]
    },
    {
      "id": "t-sandbox-verify",
      "title": "沙箱模式运行验证",
      "proposition": "用三条用例（未发货仅退款、已发货退货退款、撤销+越权）配合 mock 通知、查单 cron、失败重试与强制补偿验证沙箱链路。",
      "sectionRefs": [
        "§4"
      ]
    },
    {
      "id": "t-evidence",
      "title": "证据留存规范",
      "proposition": "每个 Feature passing 前需按 §5.1–§5.5 留存截图与日志，并执行密钥泄漏安全审计。",
      "sectionRefs": [
        "§5"
      ]
    },
    {
      "id": "t-independent-review",
      "title": "独立审查 Checklist",
      "proposition": "按各 verification.md 与本手册 §6 的 checklist 逐项勾选，并含 F12 重新验收。",
      "sectionRefs": [
        "§6"
      ]
    },
    {
      "id": "t-real-switch",
      "title": "沙箱 → 真实环境切换",
      "proposition": "仅在沙箱 passing 后，配置真实 WECHAT_REFUND_* 环境变量、移除 mock 入口，并做小金额真实退款验证与切换后回归。",
      "sectionRefs": [
        "§7"
      ]
    },
    {
      "id": "t-troubleshoot",
      "title": "故障排查速查",
      "proposition": "针对常见现象（mode 字段缺失、验签失败、查单仍 processing、重试失败、状态转移被拒、售后 Tab 不显示）给出可能原因与排查方式。",
      "sectionRefs": [
        "§8"
      ]
    },
    {
      "id": "t-pay-boundary",
      "title": "与 F01 支付域的边界",
      "proposition": "F16 退款云函数独立使用 refundCommon，不复用 payOrder / payNotify 代码，仅共享 WX_PAY_* 作为缺省回退且不修改支付核心文件。",
      "sectionRefs": [
        "§9"
      ]
    },
    {
      "id": "t-stock-decision",
      "title": "未发货仅退款库存释放时机决策",
      "proposition": "库存释放存在 APPROVED 释放（F06 老路径）与 REFUND_SUCCESS 释放（F15 当前实现）两种方案，默认推荐保守路径，需 reviewer 在 F15 passing 前决策并签字。",
      "sectionRefs": [
        "§10"
      ]
    },
    {
      "id": "t-revision",
      "title": "修订记录",
      "proposition": "记录手册 v0.1–v0.3 的修订内容，含新增 §10 决策项与 REVIEWER-GUIDE 指引。",
      "sectionRefs": [
        "§11"
      ]
    }
