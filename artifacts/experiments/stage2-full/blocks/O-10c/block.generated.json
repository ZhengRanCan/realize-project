  "content": {
    "type": "checklist",
    "panels": [
      {
        "title": "判断前提：区分三种粒度",
        "variant": "info",
        "sourceUnitIds": [
          "SU-062"
        ],
        "items": [
          {
            "text": "Outline Generation Request、Outline Generation Attempt 与 Outline Revision 不是同一粒度。",
            "note": "Request 是一次服务端请求；Attempt 是请求中的一次实际生成尝试，可能有重试；Revision 是生成成功并被接受后形成的课纲版本。",
            "variant": "plain",
            "sourceUnitIds": [
              "SU-062"
            ]
          }
        ]
      },
      {
        "title": "判断一：最终失败时，Consumption 仍可能成立",
        "variant": "ok",
        "sourceUnitIds": [
          "SU-063"
        ],
        "items": [
          {
            "text": "outline 生成结果最终失败，不等于 Consumption 未成立。",
            "note": "只要某一次实际 Attempt 已经合法使用 generation-facing projection，Consumption 就可以成立。",
            "variant": "ok",
            "sourceUnitIds": [
              "SU-063"
            ]
          }
        ]
      },
      {
        "title": "判断二：成功返回不能自动证明 Consumption",
        "variant": "warn",
        "sourceUnitIds": [
          "SU-064"
        ],
        "items": [
          {
            "text": "outline 成功返回，不能自动证明 Consumption。",
            "note": "如果 projection 没有成为真实生成输入，只能算 Receipt 或 Availability。",
            "variant": "warn",
            "sourceUnitIds": [
              "SU-064"
            ]
          }
        ]
      }
    ]
  }
}
