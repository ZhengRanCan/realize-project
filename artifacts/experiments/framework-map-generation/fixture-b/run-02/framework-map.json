  "topics": [
    {
      "id": "doc-position",
      "title": "文档定位与安全边界",
      "proposition": "本文以 fusion-c14n-v1 定稿 OpenMAIC(TS) 与 DeepTutor(Python) 共用的三个 digest/hash 的规范化字节与摘要算法，关闭 F29 缺口；SHA-256 是完整性与关联工具，不是加密，也不得因为字段最终只显示 digest 就纳入不该跨边界的正文或个人信息。",
      "sectionRefs": [
        "§1",
        "§2"
      ]
    },
    {
      "id": "canonical-pipeline",
      "title": "唯一处理流水线",
      "proposition": "三个 digest 必须经过同一条流水线：严格解析的领域对象 → 白名单投影 → Fusion 语义规范化 → Domain Separation Envelope → RFC 8785 JCS → UTF-8 bytes → SHA-256 → sha256:64 位小写 hex；任何一步不合规都必须拒绝计算。",
      "sectionRefs": [
        "§3",
        "§3.1"
      ]
    },
    {
      "id": "normalization-rules",
      "title": "通用语义规范化规则",
      "proposition": "严格解析先于规范化：先按 schema 拒绝未知字段与非法值，再统一 Unicode NFC、object key 排序与 escaping、数组 sequence/set 语义、时间、数字与缺失/null，最后按 JCS 产出无 BOM、无结尾换行的 UTF-8。",
      "sectionRefs": [
        "§4",
        "§4.1",
        "§4.2",
        "§4.3",
        "§4.4",
        "§4.5",
        "§4.6",
        "§4.7",
        "§4.8"
      ]
    },
    {
      "id": "digest-profiles",
      "title": "三个 Digest Profile",
      "proposition": "semanticRequestDigest / factSetDigest / canonicalPayloadHash 各有独立 purpose、valueSchemaVersion 与 value 白名单，并各自明确排除不进入 canonical input 的字段；purpose 使同一组 JSON 字段在不同用途下不可互换。",
      "sectionRefs": [
        "§5",
        "§6",
        "§7"
      ]
    },
    {
      "id": "versioning-and-compat",
      "title": "规范版本与兼容",
      "proposition": "规范版本由 canonicalization + purpose + valueSchemaVersion 共同决定：改说明不变版本，改受保护字段/数组语义/时间数字规则提升 valueSchemaVersion，改 JCS/Unicode/hash 算法提升 canonicalization；未知版本以 unsupported_digest_version 失败关闭。",
      "sectionRefs": [
        "§8"
      ]
    },
    {
      "id": "cross-language-impl",
      "title": "TypeScript 与 Python 实现要求",
      "proposition": "两端提供相同逻辑接口，字段投影与 JCS canonicalizer 分离；禁止依赖对象插入顺序、localeCompare、默认 json.dumps 或 Decimal 隐式转 binary64；校验 digest 使用 constant-time 比较。",
      "sectionRefs": [
        "§9"
      ]
    },
    {
      "id": "golden-fixtures-vectors",
      "title": "Golden Fixtures 与测试要求",
      "proposition": "权威测试向量位于单一 fixture 文件，每个正常向量含规范化 canonicalValue、唯一 canonicalJson、UTF-8 byte length 与预期 SHA-256 wire digest，拒绝向量记录失败阶段与稳定 reason code，两端共同消费同一文件。",
      "sectionRefs": [
        "§10"
      ]
    },
    {
      "id": "error-semantics",
      "title": "错误语义",
      "proposition": "规范建议一组稳定 reason code；客户端输入错误、版本不支持与实际 digest mismatch 均为永久失败，不进行自动无限重试，只有处理所需服务暂时不可用才进入可恢复重试。",
      "sectionRefs": [
        "§11"
      ]
    },
    {
      "id": "invariants-and-gates",
      "title": "不变量与实施门禁",
      "proposition": "先投影后 hash、字段白名单、相同语义相同字节、不同用途不可互换、hash 不是授权也不是加密、失败关闭等不变量，以及共享 fixture、负向测试等门禁，是跨 Fork digest/hash Feature 标为 passing 的前置条件。",
      "sectionRefs": [
        "§12"
      ]
    },
    {
      "id": "pending-items",
      "title": "后续实现中的待定项",
      "proposition": "本规范只关闭算法选择：现有契约字段到三份白名单的映射、每个 observation kind 的受限 value schema、RFC 8785 库锁定、数据库版本字段与索引、v1/v2 双读迁移以及四类 confidence 的 schema 提升仍待实现时完成。",
      "sectionRefs": [
        "§13"
      ]
    }
  ],
