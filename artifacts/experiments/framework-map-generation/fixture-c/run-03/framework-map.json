  "topics": [
    {
      "id": "pipeline-overview",
      "title": "整体事件驱动流水线与文档定位",
      "proposition": "本文是待实现的 DeepTutor 内部处理规范：现有「接收并返回 accepted」的能力不足以证明落盘、Learner 关联、事实化、Mastery 更新、L2/L3 Consolidate 与 Agent 判断校验，因此需要一条可恢复、可审计、可重放的后台流水线。",
      "sectionRefs": [
        "§1",
        "§2",
        "§3"
      ]
    },
    {
      "id": "candidate-ingestion",
      "title": "Candidate 接收事务与 Receipt",
      "proposition": "接收在一个短事务内完成身份/audience 校验、schema 校验、learner 解析、payloadHash、幂等唯一写入、原子写 Inbox 与初始状态，并返回 Receipt；accepted 不等于 processed，更不等于 mastery_updated 或 profile_updated。",
      "sectionRefs": [
        "§5",
        "§5.1",
        "§5.2",
        "§5.3"
      ]
    },
    {
      "id": "confidence-model-topic",
      "title": "Confidence 不是通用分数",
      "proposition": "必须区分 mappingConfidence、diagnosisConfidence、observationConfidence、aggregationConfidence 四类，保留各自来源、算法版本与缺失原因，不相乘成一个看似精确的总分。",
      "sectionRefs": [
        "§4",
        "§4.1",
        "§4.2",
        "§4.3"
      ]
    },
    {
      "id": "inbox-store",
      "title": "CandidateInboxStore 逻辑端口与物理选型",
      "proposition": "业务代码依赖逻辑端口 CandidateInboxStore；Integrated MVP、PocketBase 部署或其他等效后端都只是候选，一个部署只能选择一个权威后端，不得双写。",
      "sectionRefs": [
        "§6",
        "§6.1",
        "§6.2",
        "§6.3"
      ]
    },
    {
      "id": "persistence-model",
      "title": "逻辑持久模型",
      "proposition": "Binding、Inbox、Processing Runs、Diagnosis Records、Learning Facts 各有权威职责与字段，原始事实、处理状态与派生内容不互相冒充。",
      "sectionRefs": [
        "§7",
        "§7.1",
        "§7.2",
        "§7.3",
        "§7.4",
        "§7.5"
      ]
    },
    {
      "id": "worker-state-and-scope",
      "title": "Inbox Worker 状态机与后台用户作用域",
      "proposition": "Worker 用有限期 lease 驱动 pending/processing/retry_scheduled/processed/dead_letter/discarded 状态；每个 Processing Run 必须先经 Binding 恢复 Learner 并安装用户作用域，禁止使用 Candidate 自报 learner 或回退到 admin/default workspace。",
      "sectionRefs": [
        "§8",
        "§9"
      ]
    },
    {
      "id": "fact-projection",
      "title": "外部 Candidate 到内部事实的映射",
      "proposition": "Candidate Projection 校验观察、重读权威 DiagnosisRecord、解析映射 revision、规范化值并生成不可变 FusionLearningFact；不满足门槛的观察记为 skipped/rejected，且不复用现有 Quiz/Evidence 表作为外部 Fusion 事实的唯一权威载体。",
      "sectionRefs": [
        "§10",
        "§10.1"
      ]
    },
    {
      "id": "mastery-and-agent",
      "title": "确定性 Mastery 投影与受限 Agent",
      "proposition": "Mastery 由确定性领域服务更新、以 factId + projectorVersion 幂等且通过现有 Learning/Mastery Service 执行；Agent 只产出受约束的结构化 ProfileFactProposal，Validator 决定其能否进入 Memory。",
      "sectionRefs": [
        "§11",
        "§12"
      ]
    },
    {
      "id": "memory-consolidation-topic",
      "title": "Fusion Memory Surface 与自动 Consolidation",
      "proposition": "新增逻辑 fusion surface，由后台编排器直接调用 Memory 服务能力把 Facts 与 validated Proposals 整理为带事实引用的 L2/fusion.md 与 L3 recent/profile/scope，并按 debounce、阈值、窗口等调度，同 learner 同 L3 slot 只允许一个 consolidation lease。",
      "sectionRefs": [
        "§13",
        "§13.1"
      ]
    },
    {
      "id": "reliability",
      "title": "幂等、并发和失败恢复",
      "proposition": "每个阶段拥有独立幂等键与 revision，按至少一次执行、效果幂等设计；下游状态分别记录并可重试，重放必须指定 Projector/Policy 版本且不静默改写历史。",
      "sectionRefs": [
        "§14"
      ]
    },
    {
      "id": "outcome-and-lifecycle",
      "title": "完成语义、数据生命周期与可观测性",
      "proposition": "接收状态与下游成果拆开查询，不得用一个 success: true 覆盖全部状态；删除沿引用链执行并重建受影响的 L2/L3；提供阶段 Outcome 查询、告警指标与有权限的人工恢复入口，人工操作必须留审计。",
      "sectionRefs": [
        "§15",
        "§16",
        "§17"
      ]
    },
    {
      "id": "implementation",
      "title": "推荐实施切片与待定稿项",
      "proposition": "本文不执行实现，后续可按依赖顺序拆分七个切片，每片都要有失败注入、重启恢复、跨 learner 隔离、幂等重放和删除测试；并列出一批待实现 Feature 定稿项。",
      "sectionRefs": [
        "§18",
        "§19"
      ]
    }
  ],
