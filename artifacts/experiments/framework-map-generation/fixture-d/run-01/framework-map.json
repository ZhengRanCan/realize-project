  "topics": [
    {
      "id": "purpose-and-scope",
      "title": "Purpose and F40 conclusion",
      "proposition": "This is the F40 target data model contract for the planning domain; it sets migration direction without deleting legacy DailyPlan[] or changing storage/compatibility/AI/planner behavior.",
      "sectionRefs": [
        "§Purpose",
        "§F40 conclusion",
        "§Model layers"
      ]
    },
    {
      "id": "initial-planning-flow",
      "title": "Initial planning flow",
      "proposition": "Initial planning assembles InitialPlanContext from Goal and UserProfile and produces a validated PlanBundle without DailyReview.",
      "sectionRefs": [
        "§Initial planning flow"
      ]
    },
    {
      "id": "replanning-flow",
      "title": "Replanning flow",
      "proposition": "Replanning loads current PlanBundle and execution feedback into ReplanContext and produces a new PlanBundle or PlanChangeSet while preserving history.",
      "sectionRefs": [
        "§Replanning flow"
      ]
    },
    {
      "id": "goal-model",
      "title": "Goal model",
      "proposition": "Goal is the user's original intent and goal-scoped hard constraints with target fields for intent, success criteria, scope, starting point, and constraints.",
      "sectionRefs": [
        "§Goal"
      ]
    },
    {
      "id": "user-profile-model",
      "title": "UserProfile model",
      "proposition": "UserProfile is cross-goal reusable user context for scheduling and expression preferences, separate from daily execution energy.",
      "sectionRefs": [
        "§UserProfile"
      ]
    },
    {
      "id": "plan-bundle-and-parts",
      "title": "PlanBundle, Plan, Stage, Task",
      "proposition": "PlanBundle is the core persistent planning aggregate containing Plan, Stage[], and Task[]; Plan, Stage, and Task have target fields and lifecycle rules.",
      "sectionRefs": [
        "§PlanBundle",
        "§Plan",
        "§Stage",
        "§Task"
      ]
    },
    {
      "id": "task-card-computed-contract",
      "title": "Task Card computed contract",
      "proposition": "A pure selector derives TaskCardView availability, recommendation, and unmet dependencies from a PlanBundle without storage, AI, or mutation.",
      "sectionRefs": [
        "§Task Card computed contract"
      ]
    },
    {
      "id": "execution-history",
      "title": "FocusSession, TaskResult, DailyReview",
      "proposition": "FocusSession, TaskResult, and DailyReview are separate execution concepts: a focus process, a task execution result, and day-scoped review history.",
      "sectionRefs": [
        "§FocusSession, TaskResult and DailyReview",
        "§DailyReview"
      ]
    },
    {
      "id": "today-task-selection",
      "title": "TodayTaskSelection",
      "proposition": "TodayTaskSelection records which existing Task the user chose to execute on a concrete date, without rewriting scheduledDate.",
      "sectionRefs": [
        "§TodayTaskSelection"
      ]
    },
    {
      "id": "daily-review-prompt-dismissal",
      "title": "DailyReviewPromptDismissal",
      "proposition": "DailyReviewPromptDismissal is UI prompt history for one Goal/Plan/executionDate and is not execution or review truth.",
      "sectionRefs": [
        "§DailyReviewPromptDismissal"
      ]
    },
    {
      "id": "plan-change-summary",
      "title": "PlanChangeSummary",
      "proposition": "PlanChangeSummary is a persisted deterministic-adjustment receipt, not a second Plan truth source, with trigger fingerprint and acknowledgement.",
      "sectionRefs": [
        "§PlanChangeSummary"
      ]
    },
    {
      "id": "daily-plan-legacy-boundary",
      "title": "DailyPlan legacy boundary",
      "proposition": "DailyPlan[] does not belong to the future core domain model and is only a legacy compatibility surface until a separate breaking migration removes it.",
      "sectionRefs": [
        "§DailyPlan legacy boundary"
      ]
    },
    {
      "id": "computed-views",
      "title": "Computed views",
      "proposition": "Computed views are not persistent truth; services/selectors derive page-facing data from PlanBundle, DailyReview, and UserProfile.",
      "sectionRefs": [
        "§Computed views"
      ]
    },
    {
      "id": "migration-direction",
