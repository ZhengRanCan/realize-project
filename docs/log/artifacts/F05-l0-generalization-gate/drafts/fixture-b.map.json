  "topics": [
    {
      "id": "T-01",
      "title": "为什么不能直接 hash 原始 JSON",
      "proposition": "两段字节不同但语义相同的 JSON 必须得到同一个指纹，所以不能对收到的文本直接计算 hash。",
      "sectionRefs": ["§2"]
    },
    {
      "id": "T-02",
      "title": "唯一处理流水线",
      "proposition": "投影 → 规范化 → 信封 → JCS → UTF-8 → SHA-256；任何一步不满足规范都必须拒绝计算，不得回退到 JSON.stringify / json.dumps。",
      "sectionRefs": ["§3", "§4"]
    },
    {
      "id": "T-03",
      "title": "三个 Digest Profile 与字段白名单",
      "proposition": "只有 Profile 明确列出的字段受保护；purpose 进入 Envelope，防止同一组字段在不同用途下产生可互换的 digest。",
      "sectionRefs": ["§5", "§6", "§7"]
    },
    {
      "id": "T-04",
      "title": "版本、错误语义与实施门禁",
      "proposition": "版本由 canonicalization + purpose + valueSchemaVersion 共同决定；不认识任一版本时失败关闭，不猜测兼容。",
      "sectionRefs": ["§8", "§11", "§12", "§13"]
    },
    {
      "id": "T-05",
      "title": "跨语言实现与 Golden Fixtures",
      "proposition": "两端必须消费同一份 fixture 文件并产生逐字节相同的结果 —— 比较 canonical bytes，而不只是最终 hex。",
      "sectionRefs": ["§9", "§10"]
    }
  ],

