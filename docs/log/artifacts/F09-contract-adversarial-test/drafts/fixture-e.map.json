  "topics": [
    {
      "id": "T-01",
      "title": "前置与部署",
      "proposition": "执行前先做本地构建与密钥检查，再按依赖顺序部署云函数、配置定时触发器与 HTTP 网关。",
      "sectionRefs": ["§1", "§2", "§3"]
    },
    {
      "id": "T-02",
      "title": "正常全链路（未发货 / 已发货）",
      "proposition": "两条正常路径：未发货仅退款在 APPROVED 后直接退款；已发货退货退款需经过回寄、验货再退款。",
      "sectionRefs": ["§4", "§4.1", "§4.2", "§4.3", "§4.5"]
    },
    {
      "id": "T-03",
      "title": "撤销与越权边界",
      "proposition": "撤销只改售后状态，不触发库存、优惠券或积分回补；非订单所有者一律拒绝。",
      "sectionRefs": ["§4.4"]
    },
    {
      "id": "T-04",
      "title": "查单纠偏与有界失败",
      "proposition": "退款状态靠查单纠偏推进；连续 10 次查单失败即置 REFUND_FAILED，不让它无限等待。",
      "sectionRefs": ["§4.6", "§6.4"]
    },
    {
      "id": "T-05",
      "title": "补偿重试与人工强制补偿",
      "proposition": "补偿失败由定时重试推进；需要人工兜底时走仅管理员可调用的强制补偿，且只补资产不改售后状态。",
      "sectionRefs": ["§4.7", "§4.8"]
    },
    {
      "id": "T-06",
      "title": "证据留存与独立审查决策",
      "proposition": "每个 Feature passing 前必须留存截图与日志；库内释放时机等争议由 reviewer 决策并签字留档。",
      "sectionRefs": ["§5", "§6", "§10"]
    },
    {
      "id": "T-07",
      "title": "真实环境切换、故障排查与域边界",
      "proposition": "沙箱通过后按步骤切真实环境并回归；常见故障有对应排查方式；退款域与支付域保持独立。",
      "sectionRefs": ["§7", "§8", "§9"]
    },
    {
      "id": "T-08",
      "title": "修订记录",
      "proposition": "手册自身的版本沿革。",
      "sectionRefs": ["§11"]
    }
