    "orientation": {
      "question": {
        "summary": "售后退款链路如何运行、验证和上线，哪些边界须单独核查？",
        "detail": "这是运行验证与部署手册，涵盖正常退款、撤销/越权、失败重试、查单上限、人工审查和真实切换。操作说明不代表本次环境已验收。",
        "sources": [
          {
            "namespace": "heading",
            "key": "F13–F16 售后链路运行验证 & 部署手册",
            "quote": "拆成可由人工 reviewer 在本地或 CloudBase 环境逐步执行的操作步骤"
          }
        ]
      },
      "overview": {
        "summary": "围绕订单看用户、商家、退款接口和资产补偿怎样配合。",
        "detail": "申请/撤销、审批、退款发起/回调/查单和资产恢复配合运行；状态、权限与失败边界须分开检查。当前 F15 退款成功才补偿，提前释放库存待 reviewer 决策；沙箱通过后才进入真实环境。",
        "sources": [
          {
            "namespace": "heading",
            "key": "1",
            "quote": "依赖：**F13 → F14 → F15 → F16**。"
          },
          {
            "namespace": "heading",
            "key": "4.8",
            "quote": "仅管理员可调用；只补资产不改 `afterSalesStatus`。"
          },
          {
            "namespace": "heading",
            "key": "10",
            "quote": "未发货仅退款应采用哪种实现？"
          },
          {
            "namespace": "heading",
            "key": "7",
            "quote": "仅在沙箱 `passing` 之后执行。"
          }
        ]
      }
    },
    "elements": [
      {
        "elementId": "E-01",
        "explanation": {
          "summary": "订单保存售后进度与退款进度。",
          "detail": "订单是申请、审批、退款和纠偏共同处理的记录。售后状态与退款状态分开，不能仅凭一项状态推断资金和资产处理均已完成。",
          "sources": [
            {
              "namespace": "heading",
              "key": "4.2",
              "quote": "afterSalesStatus='APPROVED'"
            },
            {
              "namespace": "heading",
              "key": "4.2",
              "quote": "refundStatus='PROCESSING'"
            }
          ]
        }
      },
      {
        "elementId": "E-02",
        "explanation": {
          "summary": "用户申请售后，或撤销已有申请。",
          "detail": "操作改变订单售后记录；“产出”不是新建订单。撤销不回补库存、优惠券、积分；非订单所有者调用应被拒绝。",
          "sources": [
            {
              "namespace": "heading",
              "key": "4.4",
              "quote": "afterSalesStatus='CANCELLED'"
            },
            {
              "namespace": "heading",
              "key": "4.4",
              "quote": "撤销后库存 / 优惠券 / 积分不应发生变化"
            },
            {
              "namespace": "heading",
              "key": "4.4",
              "quote": "非订单所有者"
            }
          ]
        }
      },
      {
        "elementId": "E-03",
        "explanation": {
          "summary": "商家审批推进售后，退款成功后触发补偿。",
          "detail": "未发货与已发货采用不同审批路径。当前 F15 在 REFUND_SUCCESS 才触发补偿；提前释放库存是待 reviewer 确认的选择。",
          "sources": [
            {
              "namespace": "heading",
              "key": "4.2",
              "quote": "REFUND_SUCCESS"
            },
            {
              "namespace": "heading",
              "key": "4.2",
              "quote": "这是个**已知的待办**"
            }
          ]
        }
      },
      {
        "elementId": "E-04",
        "explanation": {
          "summary": "向退款接口发起这张订单的退款。",
          "detail": "申请退款后进入 PROCESSING，发起请求不代表到账。沙箱与真实环境必须区分，真实切换另有前置检查。",
          "sources": [
            {
              "namespace": "heading",
              "key": "4.2",
              "quote": "refundStatus='PROCESSING'"
            },
            {
              "namespace": "heading",
              "key": "7",
              "quote": "仅在沙箱 `passing` 之后执行。"
            }
          ]
        }
      },
      {
        "elementId": "E-05",
        "explanation": {
          "summary": "接收退款回调，推进订单与补偿链路。",
          "detail": "回调处理退款结果，沙箱成功路径触发 REFUND_SUCCESS 和资产补偿。沙箱验证成功不等于真实退款已经验收。",
          "sources": [
            {
              "namespace": "heading",
              "key": "5.4",
              "quote": "在沙箱退款成功后被调用"
            },
            {
              "namespace": "heading",
              "key": "4.3",
              "quote": "afterSalesStatus='REFUNDED', 库存 +1"
            }
          ]
        }
      },
      {
        "elementId": "E-06",
        "explanation": {
          "summary": "定时查询退款结果，纠正待处理状态。",
          "detail": "查单通常每五分钟运行，检查退款结果并推进状态；连续查单失败有上限，不能无限等待。",
          "sources": [
            {
              "namespace": "heading",
              "key": "4.6",
              "quote": "默认 5 分钟一次。"
            },
            {
              "namespace": "heading",
              "key": "6.4",
              "quote": "连续 10 次查单失败置 `REFUND_FAILED`"
            }
          ]
        }
      },
      {
        "elementId": "E-07",
        "explanation": {
          "summary": "失败后重试库存、优惠券和积分补偿。",
          "detail": "修复导致失败的数据后，重试未完成的资产恢复。重复或并发触发仍须只补偿一次。",
          "sources": [
            {
              "namespace": "heading",
              "key": "4.7",
              "quote": "手动触发 retryAfterSalesCompensation"
            },
            {
              "namespace": "heading",
              "key": "6.3",
              "quote": "并发 / 重复触发只补偿一次"
            }
          ]
        }
      },
      {
        "elementId": "E-08",
        "explanation": {
          "summary": "管理员手动补资产，不改售后状态。",
          "detail": "人工兜底入口仅允许管理员调用；只补资产，不能顺带推进 afterSalesStatus。",
          "sources": [
            {
              "namespace": "heading",
              "key": "4.8",
              "quote": "仅管理员可调用；只补资产不改 `afterSalesStatus`。"
            }
          ]
        }
      },
      {
        "elementId": "E-09",
        "explanation": {
          "summary": "补偿要恢复的库存、优惠券和积分。",
          "detail": "资产由补偿链处理，撤销不回补。有效/过期优惠券区别处理，积分只退回一次，失败须留痕。",
          "sources": [
            {
              "namespace": "heading",
              "key": "4.4",
              "quote": "撤销后库存 / 优惠券 / 积分不应发生变化"
            },
            {
              "namespace": "heading",
              "key": "6.3",
              "quote": "有效优惠券恢复为可用，过期券保持过期并有记录"
            },
            {
              "namespace": "heading",
              "key": "6.3",
              "quote": "使用积分的订单只退回一次"
            }
          ]
        }
      },
      {
        "elementId": "E-10",
        "explanation": {
          "summary": "售后状态和退款状态是两组不同进度。",
          "detail": "审批、回寄、验货、退款发起与成功对应不同状态。结合审计证据判断进度；补偿失败时订单不得被标成成功。",
          "sources": [
            {
              "namespace": "heading",
              "key": "4.3",
              "quote": "afterSalesStatus='WAIT_RETURN'"
            },
            {
              "namespace": "heading",
              "key": "4.3",
              "quote": "refundStatus='PROCESSING'"
            },
            {
              "namespace": "heading",
              "key": "6.3",
              "quote": "补偿失败时"
            }
          ]
        }
      },
      {
        "elementId": "E-11",
        "explanation": {
          "summary": "连续十次查单失败，进入退款失败状态。",
          "detail": "有界失败提供明确终止判据。这是原文要求核查的规则，不代表当前环境已实际通过。",
          "sources": [
            {
              "namespace": "heading",
              "key": "6.4",
              "quote": "连续 10 次查单失败置 `REFUND_FAILED`"
            }
          ]
        }
      },
      {
        "elementId": "E-12",
        "explanation": {
          "summary": "撤销不回补资产，越权请求被拒绝。",
          "detail": "撤销只改售后状态。非订单所有者不得撤销该订单，也不能用撤销绕过补偿时机和权限。",
          "sources": [
            {
              "namespace": "heading",
              "key": "4.4",
              "quote": "撤销后库存 / 优惠券 / 积分不应发生变化"
            },
            {
              "namespace": "heading",
              "key": "4.4",
              "quote": "非订单所有者"
            }
          ]
        }
      },
      {
        "elementId": "E-13",
        "explanation": {
