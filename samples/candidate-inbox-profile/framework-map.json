  "topics": [
    {
      "id": "T-01",
      "title": "接收事务、幂等与持久模型",
      "proposition": "接收只做短事务：验身份、校验 schema、解析 Binding、算 payloadHash、按幂等键唯一写入，然后返回 Receipt。",
      "sectionRefs": ["§5", "§6", "§7"]
    },
    {
      "id": "T-02",
      "title": "事件驱动架构与后台处理",
      "proposition": "课堂结束不等待 Agent 或 L3 更新；后台步骤先恢复 Learner 身份并安装用户作用域，再按 lease 与状态机推进，可恢复、可重放、可审计。",
      "sectionRefs": ["§2", "§3", "§8", "§14", "§15"]
    },
    {
      "id": "T-03",
      "title": "事实语义、Confidence 与 Mastery",
      "proposition": "四类 confidence 不相乘成一个总分；外部 Candidate 必须重新校验并转成不可变 Fusion Learning Fact，Mastery 由确定性领域服务投影。",
      "sectionRefs": ["§4", "§10", "§11"]
    },
    {
      "id": "T-04",
      "title": "受限 Agent 与 Memory Consolidation",
      "proposition": "Agent 只返回结构化候选，Validator 负责 schema 与证据门槛；验证失败的 Proposal 不进入 Memory，且不得直接写 mastery 或覆盖 L2/L3。",
      "sectionRefs": ["§12", "§13"]
    },
    {
      "id": "T-05",
      "title": "身份作用域、生命周期与可观测性",
      "proposition": "一律使用 Binding 冻结的 learner，不信任 Candidate 自报身份；删除沿引用链执行，人工恢复必须留审计记录。",
      "sectionRefs": ["§9", "§16", "§17"]
    },
    {
      "id": "T-06",
      "title": "实施切片与待定项",
      "proposition": "按依赖顺序拆成 7 个切片，每个切片都要有失败注入、重启恢复、跨 learner 隔离、幂等重放与删除测试。",
      "sectionRefs": ["§18", "§19"]
    }
  ],

