# 依赖
node_modules/
jspm_packages/

# 构建产物 / 打包输出
dist/
out/
build/
*.exe
*.dmg
*.AppImage

# 运行与脚本临时产物（npm run ai:plan / check-plan 的中间结果，含内网网关地址）
tmp/
*.log
npm-debug.log*
yarn-error.log*

# 本机 / 编辑器
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/settings.json
*.swp

# 环境变量与本地凭据（脚本从环境变量或 ~/.dsh/settings.yaml 读取，不要提交）
.env
.env.local
.env.*.local
