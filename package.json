{
  "name": "design-review-mvp",
  "version": "0.1.0",
  "private": true,
  "description": "AI Design Review MVP - Markdown design document -> structured design-review.json -> Electron Review UI -> human-review.json",
  "main": "app/main/main.js",
  "scripts": {
    "start": "electron .",
    "selftest": "electron . --selftest",
    "validate": "node scripts/validate-fixture.js",
    "audit": "node scripts/audit-overview.js",
    "check-plan": "node scripts/check-plan.js",
    "test:plan": "node scripts/test-check-plan.js",
    "source": "node scripts/extract-source-sections.js",
    "simulate": "node scripts/simulate-review.js",
    "ai:plan": "node scripts/ai-plan.js",
    "compare-plan": "node scripts/compare-plan.js",
    "check-block": "node scripts/check-block.js",
    "ai:block": "node scripts/ai-block.js",
    "compare-stage2": "node scripts/compare-stage2.js",
    "test:block": "node scripts/test-check-block.js",
    "test:map": "node scripts/test-check-map.js",
    "ai:framework-map": "node scripts/generate-framework-map.js",
    "test:ai-map": "node scripts/test-generate-framework-map.js",
    "test:all": "node scripts/test-check-plan.js && node scripts/test-check-block.js && node scripts/test-check-map.js && node scripts/test-generate-framework-map.js",
    "assemble": "node scripts/assemble-overview.js",
    "check-overview": "node scripts/check-overview.js",
    "check-map": "node scripts/check-map.js",
    "build-preview": "node scripts/build-preview.js",
    "report:full": "node scripts/full-run-report.js",
    "verify-preview": "electron . --verify-preview experiments/stage2-full/overview-preview.html",
    "manifest:full": "node scripts/write-full-manifest.js"
  },
  "devDependencies": {
    "electron": "^31.7.7"
  }
}
